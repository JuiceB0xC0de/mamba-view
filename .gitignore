# src/ is deliberately NOT ignored. It is generated by `./build.sh --stage`
# and must be committed, because the GitHub runner builds from a checkout of
# this repository and has no access to ~/mamba3-project.
#
# The rule that keeps it from becoming a second source of truth: never edit a
# file under src/. Fix it in ~/mamba3-project, re-stage, commit the result.

__pycache__/
*.pyc
.DS_Store

# Nothing that could carry a credential.
.env
*.token
*.key
*.pem
.netrc
